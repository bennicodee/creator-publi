# Copie para .env.local e ajuste.

# Endereço da API (pasta api/). Sem isso, usa http://localhost:5080.
VITE_API_URL=http://localhost:5080

# Ativa o "Continuar com Google". Use o mesmo valor em Google:ClientId na API.
# Google Cloud Console > APIs e serviços > Credenciais > ID do cliente OAuth (Aplicativo da Web)
# Em "Origens JavaScript autorizadas", adicione http://localhost:5173 e o domínio de produção.
VITE_GOOGLE_CLIENT_ID=
