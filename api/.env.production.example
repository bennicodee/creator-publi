# Copie para .env.production NO SERVIDOR (nunca commite o arquivo real).
# Gere valores aleatórios com: openssl rand -base64 48

# Senha do PostgreSQL (só usada dentro do Docker)
DB_PASSWORD=

# Chave que assina os tokens de login (mín. 32 caracteres)
JWT_KEY=

# Mesmo Client ID do frontend (VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=875512565630-6e97m53tna2li689r4p5s8l78vtohtjl.apps.googleusercontent.com

# Endereços do frontend autorizados a chamar a API
CORS_ORIGIN_1=https://creatorpubli.com
CORS_ORIGIN_2=https://www.creatorpubli.com
# Ex.: o endereço .workers.dev do Cloudflare, se quiser testar por ele
CORS_ORIGIN_3=

# Endereço do app, usado nos links dos e-mails (ex.: redefinir senha)
FRONTEND_URL=https://creatorpubli.com

# Envio de e-mail (SMTP). Sem SMTP_HOST, nenhum e-mail é enviado.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=nao-responda@creatorpubli.com

# Pagamento do Plano Creator (Mercado Pago). Sem MP_ACCESS_TOKEN, a assinatura é simulada.
# Configure com deploy/configure-mercadopago.sh.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Só em testes: e-mail do usuário de teste comprador do Mercado Pago
MP_TEST_PAYER_EMAIL=
